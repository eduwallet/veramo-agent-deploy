# Settings of the demo application (development environment only)
ISSUER_DEV_SANDBOX={{ tokens.sandbox.admin }}
ISSUER_SANDBOX_URL={{ protocol }}://sandbox.{{ basedomain }}

# TLS is terminated by Traefik, so the container sees plain http: the cookie flag is a setting
DEMO_COOKIE_SECURE={{ 'true' if traefik.enabled and traefik.secure == 'true' else 'false' }}
DEMO_TRACE=true
